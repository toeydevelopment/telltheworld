# PostgreSQL Configuration
POSTGRES_DB=telltheworld
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379

# NATS Configuration
NATS_PORT=4222
NATS_CLUSTER_PORT=6222
NATS_HTTP_PORT=8222

# Kafka Configuration (when using profile=kafka)
KAFKA_PORT=9092

# Server Ports
SERVER_HTTP_PORT=8000
SERVER_GRPC_PORT=9000

# PubSub Configuration
# Options: memory, nats, redis, kafka
PUBSUB_TYPE=nats
PUBSUB_NATS_URL=nats://nats:4222

# pgAdmin Configuration (when using profile=tools)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme
PGADMIN_PORT=5050

# Email Provider Configuration (for production)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Push Notification Configuration (for production)
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT=

# Worker Configuration
WORKER_STUCK_THRESHOLD=5m
WORKER_MAX_ATTEMPTS=5
WORKER_CLEANUP_INTERVAL=30s

# Environment
ENVIRONMENT=development
LOG_LEVEL=debug